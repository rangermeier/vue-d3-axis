{
  "name": "vue-d3-axis",
  "version": "0.2.2",
  "description": "Vue-based Axis component for D3",
  "repository": "https://github.com/rangermeier/vue-d3-axis.git",
  "author": "rangermeier",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-d3-axis.umd.cjs",
  "module": "./dist/vue-d3-axis.js",
  "exports": {
    ".": {
      "import": "./dist/vue-d3-axis.js",
      "require": "./dist/vue-d3-axis.umd.cjs"
    }
  },
  "types": "src/types.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "prepare": "pnpm run build",
    "setup": "pnpm install"
  },
  "peerDependencies": {
    "d3-scale": "^4.0.2",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "d3-scale": "^4.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.5",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8"
  },
  "keywords": [
    "vue",
    "component",
    "vue-component",
    "ui",
    "d3",
    "d3-axis",
    "d3-scale"
  ]
}
